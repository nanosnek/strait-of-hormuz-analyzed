# Copy to .env and fill in. .env is gitignored -- never commit real values.

# Global Fishing Watch -- the main data source.
# Register for a free token: https://globalfishingwatch.org/our-apis/
GFW_API_ACCESS_TOKEN=

# MarineTraffic reports endpoint (data_get.py) only. The live map used by
# livemap.py needs no credentials at all.
#
# To capture: sign in at marinetraffic.com, open DevTools > Network, click a
# request to /en/reports/, "Copy as cURL", and lift the two values below.
# The session expires within minutes, so expect to re-capture often.
MT_COOKIE=
MT_ACCESS_TOKEN=

# Optional -- should match the browser the cookie was captured from.
# MT_USER_AGENT=
